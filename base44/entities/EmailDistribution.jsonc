{
  "name": "EmailDistribution",
  "type": "object",
  "properties": {
    "email_type": {
      "type": "string",
      "enum": [
        "quote_submitted",
        "quote_approved",
        "quote_rejected",
        "quote_sent_to_ho",
        "ho_approved_invoice_required",
        "ho_rejected",
        "invoiced",
        "invoice_paid"
      ],
      "description": "Type of email notification"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email address to receive notifications"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of the recipient"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this recipient is active"
    }
  },
  "required": [
    "email_type",
    "recipient_email"
  ]
}