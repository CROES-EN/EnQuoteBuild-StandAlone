import { useMemo, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import {
  ResponsiveContainer, ComposedChart, Line, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend
} from "recharts";
import { Clock } from "lucide-react";

/**
 * Hourly Wait Time Summary chart - replaces the old "Report Data Overview" filter-tiles
 * section on the Executive Overview tab. Sourced from reportTables.eodb_hourly_wait_time
 * (see eodbEmailAutoImportWatcher.js's classifier + PST->MST enrichment), which stores ONE
 * ROW PER HOUR PER DATE (the "Detail" sheet layout) - completely different from the other
 * 5 EODB widgets, which store one Grand-Total value per DATE (the "Pivot" sheet layout).
 * This is why this chart aggregates by MST HOUR-OF-DAY across every date in range, rather
 * than plotting one point per date like ExecutiveOverviewCharts.jsx's other charts do.
 *
 * @param {object} props
 * @param {Array<Record<string, any>>} [props.rows] - reportTables.eodb_hourly_wait_time.rows
 * @param {{start: string, end: string}} [props.activeRange] - same ISO-date range object
 *   DashboardOverview.jsx already computes and passes to every other ranged chart/table.
 */

const LINE_METRIC_OPTIONS = [
  { value: "waitTime", label: "Avg Wait Time (min)", color: "#f59e0b" },
  { value: "talkTime", label: "Avg Talk Time (min)", color: "#8b5cf6" },
  { value: "abnRate", label: "Abandonment Rate %", color: "#f43f5e" }
];

function toNumber(value) {
  if (value === null || value === undefined || value === "") return null;
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}

// Computed HERE, on the fly, from the raw "PST Hours"/"PST Date" columns every report row
// already has regardless of import path (manual "Import This Report" OR the Auto-Import
// watcher) - rather than depending on "MST Hour"/"MST Date" columns that only exist when a
// file went through the Auto-Import watcher's enrichment. A flat +1 hour offset is correct
// because US Pacific and Mountain time move on the same DST schedule - correctly rolls hour
// 23 PST into hour 0 MST of the NEXT calendar date.
function parseFlexibleDate(value) {
  if (value instanceof Date) return value;
  if (typeof value === "number") {
    return new Date(Math.round((value - 25569) * 86400 * 1000));
  }
  if (typeof value === "string" && value.trim()) {
    // A plain Excel-serial-as-string (e.g. "46263") must be treated as a serial number, not
    // handed to `new Date(string)` - which would misinterpret it as a year and silently
    // produce a wrong/garbage date instead of throwing.
    const asNumber = Number(value);
    if (Number.isFinite(asNumber) && value.trim() === String(asNumber)) {
      return new Date(Math.round((asNumber - 25569) * 86400 * 1000));
    }
    const parsed = new Date(value);
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }
  return null;
}

function derivePstToMst(row) {
  const pstHour = toNumber(row["PST Hours"]);
  const pstDate = parseFlexibleDate(row["PST Date"]);
  if (pstHour === null || !pstDate) return { mstHour: null, mstDate: null };
  const anchored = new Date(Date.UTC(pstDate.getUTCFullYear(), pstDate.getUTCMonth(), pstDate.getUTCDate(), pstHour));
  const mst = new Date(anchored.getTime() + 60 * 60 * 1000);
  return {
    mstHour: mst.getUTCHours(),
    mstDate: `${mst.getUTCFullYear()}-${String(mst.getUTCMonth() + 1).padStart(2, "0")}-${String(mst.getUTCDate()).padStart(2, "0")}`
  };
}

function formatHourLabel(hour) {
  if (hour === null || hour === undefined) return "";
  const h = ((hour % 24) + 24) % 24;
  const period = h < 12 ? "AM" : "PM";
  const display = h % 12 === 0 ? 12 : h % 12;
  return `${display} ${period}`;
}

/**
 * Aggregates raw per-hour-per-date rows into one record per MST hour-of-day (0-23),
 * summing call counts and computing weighted averages for time-based metrics - so a hour
 * with far more calls isn't skewed by a single low-volume outlier date the same way a
 * simple unweighted average across dates would be.
 */
function aggregateByHour(rows) {
  const byHour = new Map();
  for (let h = 0; h < 24; h++) {
    byHour.set(h, { hour: h, totalCalls: 0, totalAbnCalls: 0, waitTimeWeightedSum: 0, talkTimeWeightedSum: 0, waitTimeCallBasis: 0, talkTimeCallBasis: 0 });
  }

  (rows || []).forEach((row) => {
    const { mstHour: hour } = derivePstToMst(row);
    if (hour === null || hour < 0 || hour > 23) return;
    const bucket = byHour.get(hour);

    const calls = toNumber(row["# Calls"]) || 0;
    const abnCalls = toNumber(row["# ABN Calls"]) || 0;
    const waitTime = toNumber(row["Wait Time"]);
    const talkTime = toNumber(row["Avg. Talktime"]);

    bucket.totalCalls += calls;
    bucket.totalAbnCalls += abnCalls;
    if (waitTime !== null && calls > 0) {
      bucket.waitTimeWeightedSum += waitTime * calls;
      bucket.waitTimeCallBasis += calls;
    }
    if (talkTime !== null && calls > 0) {
      bucket.talkTimeWeightedSum += talkTime * calls;
      bucket.talkTimeCallBasis += calls;
    }
  });

  return Array.from(byHour.values()).map((bucket) => ({
    hour: bucket.hour,
    hourLabel: formatHourLabel(bucket.hour),
    totalCalls: bucket.totalCalls,
    waitTime: bucket.waitTimeCallBasis > 0 ? Math.round((bucket.waitTimeWeightedSum / bucket.waitTimeCallBasis) * 10) / 10 : null,
    talkTime: bucket.talkTimeCallBasis > 0 ? Math.round((bucket.talkTimeWeightedSum / bucket.talkTimeCallBasis) * 10) / 10 : null,
    abnRate: bucket.totalCalls > 0 ? Math.round((bucket.totalAbnCalls / bucket.totalCalls) * 1000) / 10 : null
  }));
}

export default function HourlyWaitTimeChart({ rows = [], activeRange }) {
  const [lineMetric, setLineMetric] = useState("waitTime");

  const filteredRows = useMemo(() => {
    if (!activeRange?.start || !activeRange?.end) return rows;
    return (rows || []).filter((row) => {
      const { mstDate } = derivePstToMst(row);
      return typeof mstDate === "string" && mstDate >= activeRange.start && mstDate <= activeRange.end;
    });
  }, [rows, activeRange]);

  const chartData = useMemo(() => aggregateByHour(filteredRows), [filteredRows]);
  const hasAnyData = chartData.some((row) => row.totalCalls > 0);
  const activeMetric = LINE_METRIC_OPTIONS.find((opt) => opt.value === lineMetric);

  return (
    <Card className="border-border">
      <CardHeader className="pb-2">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <CardTitle className="text-sm font-semibold text-foreground">Hourly Wait Time Summary</CardTitle>
          <ToggleGroup type="single" size="sm" value={lineMetric} onValueChange={(v) => v && setLineMetric(v)}>
            {LINE_METRIC_OPTIONS.map((opt) => (
              <ToggleGroupItem key={opt.value} value={opt.value} aria-label={opt.label}>{opt.label}</ToggleGroupItem>
            ))}
          </ToggleGroup>
        </div>
        <p className="text-xs text-muted-foreground">
          Calls and {activeMetric?.label.toLowerCase()} by hour of day (Mountain Time), aggregated across the selected Reporting Period.
        </p>
      </CardHeader>
      <CardContent>
        {!hasAnyData ? (
          <div className="flex flex-col items-center justify-center gap-2 py-10 text-muted-foreground">
            <Clock className="w-8 h-8" />
            <p className="text-sm">No Hourly Wait Time data yet for this range.</p>
          </div>
        ) : (
          <ResponsiveContainer width="100%" height={300}>
            <ComposedChart data={chartData} margin={{ top: 4, right: 8, left: 0, bottom: 0 }}>
              <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
              <XAxis dataKey="hourLabel" tick={{ fontSize: 11, fill: "#64748b" }} tickLine={false} axisLine={false} interval={1} />
              <YAxis yAxisId="calls" tick={{ fontSize: 11, fill: "#64748b" }} tickLine={false} axisLine={false} label={{ value: "Calls", angle: -90, position: "insideLeft", fontSize: 11, fill: "#64748b" }} />
              <YAxis yAxisId="metric" orientation="right" tick={{ fontSize: 11, fill: "#64748b" }} tickLine={false} axisLine={false} />
              <Tooltip contentStyle={{ fontSize: 12 }} />
              <Legend wrapperStyle={{ fontSize: 12 }} />
              <Bar yAxisId="calls" dataKey="totalCalls" name="Total Calls" fill="#0ea5e9" radius={[3, 3, 0, 0]} />
              <Line yAxisId="metric" type="monotone" dataKey={lineMetric} name={activeMetric?.label} stroke={activeMetric?.color} strokeWidth={2} dot={{ r: 2 }} connectNulls />
            </ComposedChart>
          </ResponsiveContainer>
        )}
      </CardContent>
    </Card>
  );
}