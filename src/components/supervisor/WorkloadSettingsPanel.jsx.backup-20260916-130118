import { useState } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Checkbox } from "@/components/ui/checkbox";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Trash2, Plus, ChevronUp, ChevronDown, GripVertical, X } from "lucide-react";
import { cn } from "@/lib/utils";
import { ALL_OM_STATUS_VALUES } from "@/features/supervisorDashboard/workloadStatusColors";
import {
  TILE_COLOR_OPTIONS,
  getTiles,
  setTiles as saveTiles,
  resetTiles,
  DEFAULT_COLUMN_ORDER,
  getColumnOrder,
  setColumnOrder as saveColumnOrder,
  resetColumnOrder,
  getHiddenWorkloadColumns,
  setColumnHidden,
  resetHiddenColumns,
  SORTABLE_COLUMNS,
  getDefaultSortColumn,
  setDefaultSortColumn as saveDefaultSortColumn,
  getRowDensity,
  setRowDensity as saveRowDensity,
  getManagementReviewNames,
  setManagementReviewNames as saveManagementReviewNames,
  resetManagementReviewNames
} from "@/features/supervisorDashboard/workloadPreferences";

let tileIdCounter = 0;
function makeTileId() {
  tileIdCounter += 1;
  return `tile_${Date.now()}_${tileIdCounter}`;
}

/**
 * Full settings/customization panel for the Workload page - covers everything requested:
 *   - Tiles ("buttons"): editable label text, icon, color, and which O&M Status VALUES map to
 *     each one (a status can only be mapped to ONE tile at a time - selecting it under a
 *     different tile automatically un-maps it from wherever it was before, so there's never an
 *     ambiguous "which tile wins" situation).
 *   - Columns: show/hide + reorder (simple up/down move, not full drag-and-drop - kept
 *     intentionally simple; see workloadPreferences.js's header comment for why).
 *   - Default sort column.
 *   - Row density (compact/comfortable).
 *
 * Changes are staged in local component state and only committed to localStorage (via
 * onSaved()'s callback chain back to WorkloadReportTable.jsx) when "Save Changes" is clicked -
 * "Cancel" discards all edits, matching this app's existing Configure Fields/Columns pattern in
 * ReportDataTable.jsx.
 */
export default function WorkloadSettingsPanel({ open, onOpenChange, onSaved }) {
  const [tiles, setTilesState] = useState(() => getTiles().map((t) => ({ ...t })));
  const [columnOrder, setColumnOrderState] = useState(() => getColumnOrder());
  const [hiddenColumns, setHiddenColumnsState] = useState(() => getHiddenWorkloadColumns());
  const [defaultSort, setDefaultSortState] = useState(() => getDefaultSortColumn());
  const [density, setDensityState] = useState(() => getRowDensity());
  const [managementNames, setManagementNamesState] = useState(() => getManagementReviewNames());
  const [newManagementName, setNewManagementName] = useState("");

  // Tracks which tiles have had their label MANUALLY typed by the user (as opposed to
  // auto-filled from a status selection) - per explicit request: "automatically fill in text
  // based on what's selected but allow for custom typing after selecting a status." Existing
  // tiles (loaded from storage) already have real, user-set labels, so they start marked as
  // "manual" here - only a freshly ADDED tile (via addTile(), not yet in this set) gets its
  // label auto-filled the first time a status is checked for it. The moment the user types
  // directly into a tile's label box (handleLabelChange), that tile is added to this set and
  // never gets auto-overwritten again, even if they keep checking/unchecking statuses.
  const [manualLabelTileIds, setManualLabelTileIds] = useState(
    () => new Set(getTiles().map((t) => t.id))
  );

  function resetLocalStateFromStorage() {
    const freshTiles = getTiles().map((t) => ({ ...t }));
    setTilesState(freshTiles);
    setManualLabelTileIds(new Set(freshTiles.map((t) => t.id)));
    setColumnOrderState(getColumnOrder());
    setHiddenColumnsState(getHiddenWorkloadColumns());
    setDefaultSortState(getDefaultSortColumn());
    setDensityState(getRowDensity());
    setManagementNamesState(getManagementReviewNames());
    setNewManagementName("");
  }

  function handleCancel() {
    resetLocalStateFromStorage();
    onOpenChange(false);
  }

  function handleSaveAll() {
    saveTiles(tiles);
    saveColumnOrder(columnOrder);
    // Hidden columns are already persisted immediately on each toggle (see toggleColumnHidden),
    // so nothing extra to save here beyond order/tiles/sort/density/management names.
    saveDefaultSortColumn(defaultSort);
    saveRowDensity(density);
    saveManagementReviewNames(managementNames);
    onSaved?.();
    onOpenChange(false);
  }

  function handleResetAll() {
    resetTiles();
    resetColumnOrder();
    resetHiddenColumns();
    resetManagementReviewNames();
    saveDefaultSortColumn("__open");
    saveRowDensity("comfortable");
    resetLocalStateFromStorage();
    setDefaultSortState("__open");
    setDensityState("comfortable");
  }

  // --- Management review names ---
  function addManagementName() {
    const trimmed = newManagementName.trim();
    if (!trimmed) return;
    setManagementNamesState((prev) => (prev.includes(trimmed) ? prev : [...prev, trimmed]));
    setNewManagementName("");
  }

  function removeManagementName(name) {
    setManagementNamesState((prev) => prev.filter((n) => n !== name));
  }

  // --- Tiles ---
  function updateTile(id, patch) {
    setTilesState((prev) => prev.map((t) => (t.id === id ? { ...t, ...patch } : t)));
  }

  // Dedicated handler for direct label typing (vs. auto-fill from a status selection) - marks
  // the tile as "manually labeled" so it's never auto-overwritten again afterward.
  function handleLabelChange(tileId, value) {
    updateTile(tileId, { label: value });
    setManualLabelTileIds((prev) => new Set(prev).add(tileId));
  }

  function addTile() {
    // Deliberately NOT added to manualLabelTileIds - this is what makes a brand-new tile's
    // label auto-fill the first time a status is checked for it below.
    setTilesState((prev) => [
      ...prev,
      { id: makeTileId(), label: "New Tile", icon: "\u2b50", colorKey: "blue", statusValues: [] }
    ]);
  }

  function removeTile(id) {
    setTilesState((prev) => prev.filter((t) => t.id !== id));
    setManualLabelTileIds((prev) => {
      const next = new Set(prev);
      next.delete(id);
      return next;
    });
  }

  // A status can only belong to one tile at a time - toggling it ON for this tile
  // automatically removes it from any other tile that currently has it. Also auto-fills the
  // tile's label to the status name when checking a status ON, UNLESS this tile's label has
  // already been manually typed (see manualLabelTileIds above).
  function toggleTileStatus(tileId, statusValue, checked) {
    setTilesState((prev) =>
      prev.map((t) => {
        if (t.id === tileId) {
          const next = checked
            ? [...new Set([...(t.statusValues || []), statusValue])]
            : (t.statusValues || []).filter((v) => v !== statusValue);
          const shouldAutoFillLabel = checked && !manualLabelTileIds.has(tileId);
          return { ...t, statusValues: next, label: shouldAutoFillLabel ? statusValue : t.label };
        }
        if (checked) {
          return { ...t, statusValues: (t.statusValues || []).filter((v) => v !== statusValue) };
        }
        return t;
      })
    );
  }

  // --- Columns ---
  function toggleColumnHidden(column, hidden) {
    setColumnHidden(column, hidden);
    setHiddenColumnsState(getHiddenWorkloadColumns());
  }

  function moveColumn(column, direction) {
    setColumnOrderState((prev) => {
      const idx = prev.indexOf(column);
      const swapIdx = idx + direction;
      if (idx < 0 || swapIdx < 0 || swapIdx >= prev.length) return prev;
      const next = [...prev];
      [next[idx], next[swapIdx]] = [next[swapIdx], next[idx]];
      return next;
    });
  }

  // --- Column drag-and-drop reordering ---
  // Uses the browser's NATIVE HTML5 drag-and-drop (the `draggable` attribute + ondragstart/
  // ondragover/ondrop) rather than a drag-and-drop library - deliberately, to avoid adding a
  // new npm dependency for a single reorder feature in a settings panel. The up/down arrow
  // buttons above are kept alongside this (not replaced), since native drag-and-drop has no
  // built-in keyboard or screen-reader support - the arrows remain the fully-accessible path
  // to the exact same reordering, drag-and-drop is just a faster/more visual alternative.
  const [draggedColumn, setDraggedColumn] = useState(null);
  const [dragOverColumn, setDragOverColumn] = useState(null);

  function handleColumnDragStart(column) {
    setDraggedColumn(column);
  }

  function handleColumnDragOver(e, column) {
    e.preventDefault(); // required for onDrop to fire at all, per the native drag-and-drop API
    if (column !== draggedColumn) setDragOverColumn(column);
  }

  function handleColumnDragLeave(column) {
    setDragOverColumn((prev) => (prev === column ? null : prev));
  }

  function handleColumnDrop(targetColumn) {
    if (!draggedColumn || draggedColumn === targetColumn) {
      setDraggedColumn(null);
      setDragOverColumn(null);
      return;
    }
    setColumnOrderState((prev) => {
      const next = [...prev];
      const fromIdx = next.indexOf(draggedColumn);
      const toIdx = next.indexOf(targetColumn);
      if (fromIdx < 0 || toIdx < 0) return prev;
      next.splice(fromIdx, 1);
      next.splice(toIdx, 0, draggedColumn);
      return next;
    });
    setDraggedColumn(null);
    setDragOverColumn(null);
  }

  function handleColumnDragEnd() {
    setDraggedColumn(null);
    setDragOverColumn(null);
  }

  if (!open) return null;

  return (
    <Dialog open={open} onOpenChange={(next) => { if (!next) handleCancel(); }}>
      <DialogContent className="max-h-[85vh] max-w-3xl overflow-y-auto">
        <DialogHeader>
          <DialogTitle>Customize Workload</DialogTitle>
        </DialogHeader>

        <div className="space-y-6 py-2">
          {/* Tiles section */}
          <section className="space-y-3">
            <div className="flex items-center justify-between">
              <h3 className="text-sm font-semibold text-foreground">Tiles / Buttons</h3>
              <Button size="sm" variant="outline" onClick={addTile}>
                <Plus className="mr-1.5 h-3.5 w-3.5" /> Add Tile
              </Button>
            </div>
            <p className="text-xs text-muted-foreground">
              Rename any tile, change its icon/color, and choose which O&M Status values feed
              into it. A status can only belong to one tile at a time. Rows whose status is
              mapped to a tile get highlighted and float to the top of the default sort.
              Checking a status auto-fills the tile's label with that status's name until you
              type your own - once you type a custom label, it stays exactly as you typed it.
            </p>
            <div className="space-y-3">
              {tiles.map((tile) => (
                <div key={tile.id} className="rounded-lg border border-border bg-secondary p-3">
                  <div className="flex flex-wrap items-center gap-2">
                    <Input
                      value={tile.icon}
                      onChange={(e) => updateTile(tile.id, { icon: e.target.value })}
                      className="w-14 text-center"
                      maxLength={4}
                      aria-label="Tile icon"
                    />
                    <Input
                      value={tile.label}
                      onChange={(e) => handleLabelChange(tile.id, e.target.value)}
                      className="w-48"
                      placeholder="Tile label"
                      aria-label="Tile label"
                    />
                    <Select value={tile.colorKey} onValueChange={(v) => updateTile(tile.id, { colorKey: v })}>
                      <SelectTrigger className="w-32">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        {TILE_COLOR_OPTIONS.map((c) => (
                          <SelectItem key={c.key} value={c.key}>{c.colorLabel}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                    <Button
                      size="sm"
                      variant="ghost"
                      className="ml-auto text-rose-600 hover:bg-rose-50 hover:text-rose-700"
                      onClick={() => removeTile(tile.id)}
                    >
                      <Trash2 className="mr-1.5 h-3.5 w-3.5" /> Remove
                    </Button>
                  </div>
                  <div className="mt-3">
                    <p className="mb-1.5 text-xs font-medium text-muted-foreground">Maps to these O&M Status values:</p>
                    <div className="grid max-h-32 grid-cols-2 gap-x-4 gap-y-1 overflow-auto rounded border border-border bg-card p-2 sm:grid-cols-3">
                      {ALL_OM_STATUS_VALUES.map((status) => (
                        <label key={status} className="flex cursor-pointer items-center gap-2 py-0.5 text-xs text-foreground">
                          <Checkbox
                            checked={(tile.statusValues || []).includes(status)}
                            onCheckedChange={(checked) => toggleTileStatus(tile.id, status, checked === true)}
                          />
                          {status}
                        </label>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
              {tiles.length === 0 && (
                <p className="rounded-lg border border-dashed border-border p-4 text-center text-xs text-muted-foreground">
                  No tiles configured - click "Add Tile" to create one.
                </p>
              )}
            </div>
          </section>

          {/* Columns section */}
          <section className="space-y-2">
            <h3 className="text-sm font-semibold text-foreground">Columns</h3>
            <p className="text-xs text-muted-foreground">
              Show/hide columns, and reorder them by dragging the handle - or use the arrows if
              you'd rather click. "Open" is always shown first, ahead of this list.
            </p>
            <div className="divide-y divide-border rounded-lg border border-border">
              {columnOrder.map((col, index) => (
                <div
                  key={col}
                  draggable
                  onDragStart={() => handleColumnDragStart(col)}
                  onDragOver={(e) => handleColumnDragOver(e, col)}
                  onDragLeave={() => handleColumnDragLeave(col)}
                  onDrop={() => handleColumnDrop(col)}
                  onDragEnd={handleColumnDragEnd}
                  className={cn(
                    "flex items-center justify-between gap-2 px-3 py-1.5 transition-colors",
                    draggedColumn === col && "opacity-40",
                    dragOverColumn === col && draggedColumn !== col && "bg-indigo-500/10 ring-1 ring-inset ring-indigo-400"
                  )}
                >
                  <div className="flex flex-1 items-center gap-2">
                    <span
                      className="cursor-grab text-muted-foreground active:cursor-grabbing"
                      title="Drag to reorder"
                      aria-hidden="true"
                    >
                      <GripVertical className="h-4 w-4" />
                    </span>
                    <label className="flex flex-1 cursor-pointer items-center gap-2 text-sm text-foreground">
                      <Checkbox
                        checked={!hiddenColumns.has(col)}
                        onCheckedChange={(checked) => toggleColumnHidden(col, checked !== true)}
                      />
                      {col}
                    </label>
                  </div>
                  <div className="flex shrink-0 gap-1">
                    <Button
                      size="icon"
                      variant="ghost"
                      className="h-6 w-6"
                      disabled={index === 0}
                      onClick={() => moveColumn(col, -1)}
                      title="Move up"
                    >
                      <ChevronUp className="h-3.5 w-3.5" />
                    </Button>
                    <Button
                      size="icon"
                      variant="ghost"
                      className="h-6 w-6"
                      disabled={index === columnOrder.length - 1}
                      onClick={() => moveColumn(col, 1)}
                      title="Move down"
                    >
                      <ChevronDown className="h-3.5 w-3.5" />
                    </Button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Management review names - ties the "Review Me" button to Case Last Modified By */}
          <section className="space-y-2">
            <h3 className="text-sm font-semibold text-foreground">Review Me List</h3>
            <p className="text-xs text-muted-foreground">
              The "Review Me" button counts and filters to cases whose "Case Last Modified By"
              matches one of these names - these are the people whose edits mean "go review
              this," typically your management.
            </p>
            <div className="flex flex-wrap gap-2">
              {managementNames.map((name) => (
                <span
                  key={name}
                  className="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-700"
                >
                  {name}
                  <button
                    type="button"
                    onClick={() => removeManagementName(name)}
                    className="rounded-full hover:bg-indigo-500/20"
                    aria-label={`Remove ${name}`}
                  >
                    <X className="h-3 w-3" />
                  </button>
                </span>
              ))}
              {managementNames.length === 0 && (
                <p className="text-xs text-muted-foreground">No names configured - Review Me will always show 0.</p>
              )}
            </div>
            <div className="flex gap-2">
              <Input
                value={newManagementName}
                onChange={(e) => setNewManagementName(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); addManagementName(); } }}
                placeholder="Full name as it appears in Case Last Modified By"
                className="flex-1"
              />
              <Button size="sm" variant="outline" onClick={addManagementName}>
                <Plus className="mr-1.5 h-3.5 w-3.5" /> Add
              </Button>
            </div>
          </section>

          {/* Default sort + density */}
          <section className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div className="space-y-2">
              <h3 className="text-sm font-semibold text-foreground">Default Sort</h3>
              <Select value={defaultSort} onValueChange={setDefaultSortState}>
                <SelectTrigger className="w-full">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  {SORTABLE_COLUMNS.map((c) => (
                    <SelectItem key={c.key} value={c.key}>{c.label}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            <div className="space-y-2">
              <h3 className="text-sm font-semibold text-foreground">Row Density</h3>
              <div className="flex gap-2">
                <Button
                  size="sm"
                  variant={density === "comfortable" ? "default" : "outline"}
                  className="flex-1"
                  onClick={() => setDensityState("comfortable")}
                >
                  Comfortable
                </Button>
                <Button
                  size="sm"
                  variant={density === "compact" ? "default" : "outline"}
                  className="flex-1"
                  onClick={() => setDensityState("compact")}
                >
                  Compact
                </Button>
              </div>
            </div>
          </section>
        </div>

        <DialogFooter className="flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between">
          <Button variant="ghost" className="text-rose-600 hover:bg-rose-50 hover:text-rose-700" onClick={handleResetAll}>
            Reset All to Default
          </Button>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={handleCancel}>Cancel</Button>
            <Button onClick={handleSaveAll}>Save Changes</Button>
          </div>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
